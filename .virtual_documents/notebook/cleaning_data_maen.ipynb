df_sorted['is_confirm'] = df_sorted['process_step'] == 'confirm'

# Group by visit_id
durations = []

for visit_id, group in df_sorted.groupby('visit_id'):
    group = group.reset_index(drop=True)

    errors = group['error'].any()
    if errors:
        continue  # skip visits with any error

    steps = group['process_step'].tolist()
    if 'start' in steps and 'confirm' in steps:
        start_time = group[group['is_start']].iloc[0]['date_time']
        confirm_time = group[group['is_confirm']].iloc[-1]['date_time']
        duration = confirm_time - start_time

        row = group.iloc[-1].copy()  # or pick whichever row you want to attach the result to
        row['start_time'] = start_time
        row['end_time'] = confirm_time
        row['duration'] = duration
        durations.append(row)

df_durations = pd.DataFrame(durations)



print(df_durations.head())
print(f"Total duration processes: {len(df_durations)}")



print(f"Average duration: {df_durations['duration'].mean()}")



